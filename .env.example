# Local-only defaults. Copy to .env before use.
TRANSCRIPT_OUTPUT_DIR=./outputs
WHISPER_MODEL_CACHE=./model-cache
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
TRANSCRIBE_CPU_THREADS=4

# true keeps inference preparation fully offline: a model must already be in
# WHISPER_MODEL_CACHE. Set false only for an explicit model-only prefetch.
WHISPER_LOCAL_FILES_ONLY=true
